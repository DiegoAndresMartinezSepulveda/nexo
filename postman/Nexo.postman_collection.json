    {
      "name": "16 · Sesión móvil y acceso a fotos",
      "description": "Pruebas opcionales de Capacitor/Android. El token se guarda como variable local de esta colección; no lo exportes ni compartas.",
      "item": [
        {
          "name": "Iniciar sesión móvil",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/mobile/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "mobile",
                "login"
              ]
            },
            "description": "Guarda el token Bearer en mobile_token y el ID del usuario en user_id/profile_user_id.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"captcha_id\": \"{{captcha_id}}\",\n  \"captcha_answer\": \"{{captcha_answer}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.captcha_required) {",
                  "  pm.collectionVariables.set('captcha_id', data.captcha_id);",
                  "  pm.collectionVariables.set('captcha_question', data.captcha_question);",
                  "  pm.collectionVariables.set('captcha_answer', '');",
                  "  pm.test('Desafío de verificación recibido', () => pm.response.to.have.status(422));",
                  "} else if (data.blocked) {",
                  "  pm.test('Bloqueo temporal informado', () => pm.response.to.have.status(429));",
                  "} else {",
                  "  pm.test('Login correcto', () => pm.response.to.have.status(200));",
                  "  if (data.token) pm.collectionVariables.set('mobile_token', data.token);",
                  "  if (data.user) {",
                  "    pm.collectionVariables.set('user_id', String(data.user.id));",
                  "    pm.collectionVariables.set('profile_user_id', String(data.user.id));",
                  "  }",
                  "  pm.collectionVariables.set('captcha_id', '');",
                  "  pm.collectionVariables.set('captcha_question', '');",
                  "  pm.collectionVariables.set('captcha_answer', '');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar sesión móvil",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{mobile_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/mobile/session",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "mobile",
                "session"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Sesión móvil válida', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Crear token temporal para imágenes",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{mobile_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/mobile/asset-token",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "mobile",
                "asset-token"
              ]
            },
            "description": "El token de imagen expira a los 15 minutos."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Token de imagen creado', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "if (data.token) pm.collectionVariables.set('mobile_asset_token', data.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Ver foto como la app Android",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "image/*"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/users/{{profile_user_id}}/photo?asset_token={{mobile_asset_token}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "users",
                "{{profile_user_id}}",
                "photo?asset_token={{mobile_asset_token}}"
              ]
            },
            "description": "Usa el token temporal anterior; esta solicitud de imagen no necesita encabezado Bearer."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Foto accesible', () => pm.response.to.have.status(200));",
                  "pm.test('La respuesta es una imagen', () => pm.expect(pm.response.headers.get('Content-Type')).to.match(/^image\\//));"
                ]
              }
            }
          ]
        }
      ]
    }
