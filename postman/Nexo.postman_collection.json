          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "entries"
          ]
        },
        "description": "Petición opcional: crea una nota real en el espacio seleccionado.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"kind\": \"note\",\n  \"title\": \"Nota de prueba Postman\",\n  \"color\": \"blue\",\n  \"pinned\": false,\n  \"archived\": false,\n  \"blocks\": [\n    {\n      \"type\": \"text\",\n      \"html\": \"<p>Nota creada desde Postman.</p>\"\n    }\n  ],\n  \"client_id\": null,\n  \"project_id\": null,\n  \"tags\": []\n}",
          "options": {
