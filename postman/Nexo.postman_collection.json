{
  "info": {
    "name": "Nexo · API privada",
    "description": "Colección para probar la API JSON de Nexo. No contiene credenciales. Las peticiones web usan cookies de sesión Laravel; ejecuta 01 y luego 02. Las peticiones nativas usan token Bearer.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const xsrf = pm.cookies.get('XSRF-TOKEN');",
          "if (xsrf) {",
          "  pm.request.headers.upsert({ key: 'X-XSRF-TOKEN', value: decodeURIComponent(xsrf) });",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "https://diegomartinezsepulveda.cl"
    },
    {
      "key": "workspace_id",
      "value": ""
    },
    {
      "key": "task_id",
      "value": ""
    },
    {
      "key": "entry_id",
      "value": ""
    },
    {
      "key": "user_id",
      "value": ""
    },
    {
      "key": "environment",
      "value": "backlog"
    },
    {
      "key": "entry_kind",
      "value": "note"
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "profile_user_id",
      "value": ""
    },
    {
      "key": "mobile_token",
      "value": ""
    },
    {
      "key": "mobile_asset_token",
      "value": ""
    },
    {
      "key": "two_factor_code",
      "value": ""
    },
    {
      "key": "captcha_id",
      "value": ""
    },
    {
      "key": "captcha_question",
      "value": ""
    },
    {
      "key": "captcha_answer",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 · Sesión / obtener cookies",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/session",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "session"
          ]
        },
        "description": "Ejecuta esta petición antes de iniciar sesión para que Postman reciba la cookie XSRF-TOKEN."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('La sesión responde', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 · Iniciar sesión",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"captcha_id\": \"{{captcha_id}}\",\n  \"captcha_answer\": \"{{captcha_answer}}\",\n  \"two_factor_code\": \"{{two_factor_code}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Si la cuenta tiene 2FA, completa two_factor_code con el código de Authenticator o uno de recuperación y vuelve a enviar; cuando haya fallos también se pedirá captcha."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const data = pm.response.json();",
              "if (data.captcha_required) {",
              "  pm.collectionVariables.set('captcha_id', data.captcha_id);",
              "  pm.collectionVariables.set('captcha_question', data.captcha_question);",
              "  pm.collectionVariables.set('captcha_answer', '');",
              "}",
              "if (data.two_factor_required) {",
              "  pm.collectionVariables.set('two_factor_code', '');",
              "  pm.test('Se requiere el segundo factor', () => pm.response.to.have.status(422));",
              "} else if (data.blocked) {",
              "  pm.test('Bloqueo temporal informado', () => pm.response.to.have.status(429));",
              "} else if (data.captcha_required) {",
              "  pm.test('Desafío de verificación recibido', () => pm.response.to.have.status(422));",
              "} else {",
              "  pm.test('Login correcto', () => pm.response.to.have.status(200));",
              "  if (data.user) {",
              "    pm.collectionVariables.set('user_id', String(data.user.id));",
              "    pm.collectionVariables.set('profile_user_id', String(data.user.id));",
              "  }",
              "  pm.collectionVariables.set('captcha_id', '');",
              "  pm.collectionVariables.set('captcha_question', '');",
              "  pm.collectionVariables.set('captcha_answer', '');",
              "  pm.collectionVariables.set('two_factor_code', '');",
              "}"
            ]
          }
        }
      ]
    },
