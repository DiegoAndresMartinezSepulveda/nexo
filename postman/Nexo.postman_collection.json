        },
        {
          "name": "Ver mi foto (después de subirla)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "image/*"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/users/{{profile_user_id}}/photo",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "users",
                "{{profile_user_id}}",
                "photo"
              ]
            },
            "description": "Descarga la foto privada. Si todavía no hay foto, la API responde 404."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
